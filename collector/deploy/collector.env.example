# /etc/stock-collector.env 에 채우세요. 채팅/깃에 절대 올리지 마세요.
# Oracle Autonomous DB (TLS 연결 문자열 전체, 콘솔 > Database connection > TLS > *_low)
DB_USER=stock
DB_PASSWORD=
DB_CONNECT_STRING=
# 앱 주소 (시총 순위 조회, 손절 체크 호출)
APP_URL=https://
# Vercel 의 CRON_SECRET 과 같은 값 (장중 1분마다 손절·익절 체크 호출용, 비우면 끔)
CRON_SECRET=
# 게이트웨이 /etc/toss-gateway.env 의 INTERNAL_KEY 와 같은 값 (수급 수집용)
INTERNAL_KEY=
